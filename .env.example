POSTGRES_DB=kocluk
POSTGRES_USER=kocluk
POSTGRES_PASSWORD=change-this-in-production
ASPNETCORE_ENVIRONMENT=Production
DatabaseProvider=Postgres
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=kocluk;Username=kocluk;Password=change-this-in-production

# E-posta sağlayıcısı bilgileri (SMTP/SendGrid entegrasyonu için)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
APP_PUBLIC_URL=https://app.example.com

# İlk production admin hesabı (kurulumdan sonra kaldırın/değiştirin)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisStrongPassword123

# Hata izleme
SENTRY_DSN=

# Ödeme sağlayıcısı
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_SECRET=
BILLING_WEBHOOK_SECRET=

# Staging Compose için (production değişkenlerinden ayrı kullanın)
STAGING_POSTGRES_DB=kocluk_staging
STAGING_POSTGRES_USER=kocluk_staging
STAGING_POSTGRES_PASSWORD=change-this-staging-password
STAGING_PUBLIC_URL=http://localhost:8081
COACH_TIME_ZONE=Europe/Istanbul
